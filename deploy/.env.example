# ── 端口共存（与 .226 上的 Dify 共存）────────────────────
# Dify 保持默认 :80（入口）与 :3000（web），本平台门户用独立端口：
PORTAL_PORT=8080
# Postgres 不对宿主机发布（容器网内访问），如需调试可自行加 ports 映射

# Agent Platform — deploy/.env.example
# 用法: cp .env.example .env && 编辑下面各项（生成命令见注释）

# ── Postgres（compose 内 postgres 服务使用；backend 经 DATABASE_URL 连接）──
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev_only   # 生产必须改强密码

# ── Backend（backend 容器 env_file 加载；DATABASE_URL 由 compose 覆盖注入）──
# JWT 签名密钥，仅用于 JWT；生成: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-min-32-bytes-random-string-xxxx
# Dify API Key 加密密钥（Fernet）；生成: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-base64-key==

# Dify 服务 API 地址（已部署的生产实例，社区版）
DIFY_BASE_URL=http://192.168.20.226

# CSRF Origin 白名单（逗号分隔）；生产填门户正式地址（含端口！）。
# remote-env.sh 生成的 env 会按 PORTAL_PORT 自动推导；手改端口时必须同步改这里
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

DEBUG=false
# 纯 HTTP 部署阶段必须 false（浏览器拒收 Secure cookie → 登录无法保持）；
# TLS 就绪后删除此行（缺省跟随 not DEBUG 自动收紧）
COOKIE_SECURE=false
