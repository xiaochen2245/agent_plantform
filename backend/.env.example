# 复制为 .env 并按环境覆盖；生产必须全部改强值
APP_NAME=Agent Platform
DEBUG=true

# 32+ 字节随机串：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-jwt-secret-change-me-in-production-32b
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 预留：Dify API Key 加密密钥（Fernet，后续切片启用）
ENCRYPTION_KEY=dev-only-encryption-key-not-used-yet

# dev 默认 SQLite；生产：postgresql+asyncpg://agent:agent@postgres:5432/agent_platform
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# CSRF/CORS 白名单（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Dify 服务 API 基址（SSE 代理出口；测试不真调，FakeDify 替身）
DIFY_BASE_URL=http://192.168.20.226

# 每个 App 的 Dify API Key：环境变量 DIFY_API_KEY_APP_<id>，缺省 demo-key
# 例：DIFY_API_KEY_APP_1=app-xxxxxxxxxxxxxxxx
# 后续切片将迁入 dify_api_keys 表加密存储

# dev 种子管理员
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=admin123

# RAGFlow 引擎（v0.26+，/api/rag 路由；未配置时相关端点返回 503）
RAGFLOW_BASE_URL=http://192.168.20.226:9380
RAGFLOW_API_KEY=

# W2 租户绑定（ragflow_bindings 表 + /api/rag/bindings 自动开通）
RAGFLOW_PUBLIC_KEY="""-----BEGIN PUBLIC KEY-----
<RAGFlow 镜像内置 public.pem，docker exec <ragflow> cat /ragflow/conf/public.pem>
-----END PUBLIC KEY-----"""
RAGFLOW_EMBEDDING_MODEL=BAAI/bge-m3
RAGFLOW_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
SILICONFLOW_API_KEY=
SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
